<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}CS Career Hub | Symfony{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>✦</text></svg>">
        <style>
            :root {
                --bg-main: #060a13;
                --bg-card: #0e1628;
                --bg-card-hover: #182542;
                --text-primary: #f8fafc;
                --text-secondary: #94a3b8;
                --accent-blue: #38bdf8;
                --accent-blue-hover: #0284c7;
                --accent-emerald: #10b981;
                --accent-amber: #f59e0b;
                --border-color: rgba(148, 163, 184, 0.2);
            }
            * { box-sizing: border-box; }
            body {
                margin: 0;
                font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                background: radial-gradient(circle at 15% 10%, rgba(56, 189, 248, 0.08), transparent 40%),
                            radial-gradient(circle at 85% 15%, rgba(245, 158, 11, 0.07), transparent 40%),
                            var(--bg-main);
                color: var(--text-primary);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }
            header {
                background-color: rgba(9, 15, 29, 0.92);
                border-bottom: 1px solid var(--border-color);
                padding: 0.9rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
                position: sticky;
                top: 0;
                z-index: 100;
                backdrop-filter: blur(10px);
            }
            .brand-logo {
                font-size: 1.25rem;
                font-weight: 800;
                letter-spacing: 0.4px;
                color: var(--text-primary);
                cursor: default;
                user-select: none;
                display: flex;
                align-items: center;
                gap: 0.55rem;
            }
            .brand-badge {
                background: linear-gradient(135deg, #2563eb, #38bdf8);
                color: #ffffff;
                font-size: 0.68rem;
                padding: 0.15rem 0.5rem;
                border-radius: 999px;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-weight: 700;
            }
            nav {
                display: flex;
                gap: 0.5rem;
                flex-wrap: wrap;
                align-items: center;
            }
            nav a {
                color: var(--text-secondary);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 0.45rem 0.8rem;
                border-radius: 8px;
                transition: all 0.2s ease;
                border: 1px solid transparent;
            }
            nav a:hover, nav a.active {
                color: var(--text-primary);
                background-color: var(--bg-card-hover);
                border-color: rgba(148, 163, 184, 0.25);
            }
            .nav-guest.active, .nav-guest:hover {
                color: #6ee7b7;
                border-color: rgba(16, 185, 129, 0.35);
            }
            .nav-admin.active, .nav-admin:hover {
                color: #fcd34d;
                border-color: rgba(245, 158, 11, 0.35);
            }
            main {
                flex: 1;
                width: 100%;
                max-width: 1120px;
                margin: 0 auto;
                padding: 2.25rem 1.5rem;
            }
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.4rem;
                padding: 0.65rem 1.2rem;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 700;
                font-size: 0.9rem;
                transition: transform 0.15s ease, filter 0.2s ease, background-color 0.2s ease;
                border: none;
                cursor: pointer;
            }
            .btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
            .btn-blue { background: linear-gradient(135deg, #2563eb, #0284c7); color: #ffffff; }
            .btn-emerald { background: linear-gradient(135deg, #059669, #10b981); color: #04130e; }
            .btn-amber { background: linear-gradient(135deg, #d97706, #f59e0b); color: #090d16; }
            .btn-slate { background: #1e293b; color: #f8fafc; border: 1px solid #475569; }
            footer {
                text-align: center;
                padding: 1.4rem;
                border-top: 1px solid var(--border-color);
                color: var(--text-secondary);
                font-size: 0.85rem;
                background: rgba(6, 10, 19, 0.85);
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% set current_route = app.request.attributes.get('_route') %}
        <header>
            <div class="brand-logo">
                <span>✦ CS Career Hub</span>
                <span class="brand-badge">Orbital</span>
            </div>
            <nav>
                <a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'active' : '' }}">Home</a>
                <a href="{{ path('app_numbers') }}" class="{{ current_route == 'app_numbers' ? 'active' : '' }}">View Numbers</a>
                <a href="{{ path('app_job_index') }}" class="{{ current_route starts with 'app_job' ? 'active' : '' }}">Job Offers</a>
                <a href="{{ path('app_unified_access') }}" class="nav-guest {{ current_route in ['app_unified_access', 'app_login_page'] ? 'active' : '' }}">Login / Register</a>
                <a href="{{ path('app_admin_portal') }}" class="nav-admin {{ current_route starts with 'app_admin' or current_route starts with 'app_candidate' ? 'active' : '' }}">Admin &amp; Candidates</a>
            </nav>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer>
            CS Career Hub &bull; Guest Applications &amp; Admin Candidate Command &bull; Built with Symfony
        </footer>
    </body>
</html>