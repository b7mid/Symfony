{% extends 'base.html.twig' %}

{% block title %}CS Market Statistics | TechPortal{% endblock %}

{% block body %}
    <div style="text-align: center; margin-bottom: 2.5rem;">
        <h1 style="margin: 0 0 0.5rem; font-size: 2rem;">Computer Science Market Analytics</h1>
        <p style="color: var(--text-secondary); margin: 0;">Industry benchmarks, compensation trends, and skill demand indicators.</p>
    </div>

    <!-- Visual Metric Cards with Animated Bars -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        {% for stat in stats %}
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 10px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem;">
                        <h3 style="margin: 0; font-size: 1rem; color: var(--text-secondary);">{{ stat.title }}</h3>
                        <span style="font-size: 1.75rem; font-weight: 700; color: {{ stat.color }};">{{ stat.value }}</span>
                    </div>
                    <!-- Progress Bar -->
                    <div style="width: 100%; height: 8px; background: #0f172a; border-radius: 4px; overflow: hidden; margin-bottom: 1rem;">
                        <div style="width: {{ stat.percent }}%; height: 100%; background: {{ stat.color }}; border-radius: 4px;"></div>
                    </div>
                    <p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
                        {{ stat.description }}
                    </p>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Interactive Compensation & Role Estimator -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 2rem; border-radius: 12px; max-width: 700px; margin: 0 auto 2rem;">
        <h2 style="margin-top: 0; font-size: 1.35rem;">Interactive CS Compensation Estimator</h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">Select a specialization and experience level to estimate benchmark annual compensation.</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
                <label style="display: block; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.4rem;">Specialization Track</label>
                <select id="trackSelect" onchange="calculateEstimate()" style="width: 100%; padding: 0.65rem; border-radius: 6px; background: var(--bg-main); color: var(--text-primary); border: 1px solid var(--border-color);">
                    <option value="115000">Full-Stack Web Developer (Symfony / JS)</option>
                    <option value="130000">Cybersecurity & Penetration Tester</option>
                    <option value="135000">Data Engineer / Machine Learning</option>
                    <option value="120000">Cloud & Network Infrastructure Engineer</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.4rem;">Experience Level</label>
                <select id="levelSelect" onchange="calculateEstimate()" style="width: 100%; padding: 0.65rem; border-radius: 6px; background: var(--bg-main); color: var(--text-primary); border: 1px solid var(--border-color);">
                    <option value="0.75">Junior / Graduate (0–2 yrs)</option>
                    <option value="1.0" selected>Mid-Level Engineer (2–5 yrs)</option>
                    <option value="1.35">Senior / Lead Architect (5+ yrs)</option>
                </select>
            </div>
        </div>

        <div style="background: var(--bg-main); padding: 1.25rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color);">
            <span style="color: var(--text-secondary); font-weight: 500;">Estimated Market Benchmark:</span>
            <span id="estimateOutput" style="font-size: 1.75rem; font-weight: 700; color: var(--accent-emerald);">$115,000 / yr</span>
        </div>
    </div>

    <div style="text-align: center;">
        <a href="{{ path('app_home') }}" class="btn btn-slate">&larr; Back to Dashboard</a>
    </div>

    <script>
        function calculateEstimate() {
            const base = parseFloat(document.getElementById('trackSelect').value);
            const mult = parseFloat(document.getElementById('levelSelect').value);
            const total = Math.round(base * mult);
            document.getElementById('estimateOutput').textContent = '$' + total.toLocaleString() + ' / yr';
        }
    </script>
{% endblock %}