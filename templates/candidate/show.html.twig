{% extends 'base.html.twig' %}

{% set identifier = candidate.email ?? candidate.userIdentifier ?? 'Candidate Profile' %}

{% block title %}{{ identifier }} | CS Career Hub{% endblock %}

{% block stylesheets %}
<style>
    .dossier-shell {
        max-width: 860px;
        margin: 0 auto;
        position: relative;
    }

    .dossier-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .dossier-page-title {
        margin: 0;
        font-size: 1.95rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #f8fafc;
    }

    .dossier-card {
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.14), transparent 45%),
                    radial-gradient(circle at 10% 90%, rgba(56, 189, 248, 0.14), transparent 45%),
                    linear-gradient(160deg, #111827 0%, #090e1a 100%);
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 24px 55px rgba(0, 0, 0, 0.6);
    }

    .dossier-top-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    }

    .dossier-id-chip {
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.85rem;
        font-weight: 700;
        color: #6ee7b7;
        background: rgba(16, 185, 129, 0.14);
        border: 1px solid rgba(16, 185, 129, 0.35);
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
    }

    .dossier-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.14);
        border: 1px solid rgba(56, 189, 248, 0.32);
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
    }

    .dossier-profile-banner {
        display: flex;
        align-items: center;
        gap: 1.15rem;
        margin-bottom: 1.5rem;
    }

    .dossier-avatar {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, #10b981, #0284c7);
        color: #ffffff;
        font-size: 1.45rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);
    }

    .dossier-field-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .dossier-meta-box {
        background: rgba(15, 23, 42, 0.82);
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 12px;
        padding: 1rem 1.15rem;
    }

    .dossier-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: #94a3b8;
        margin-bottom: 0.4rem;
    }

    .dossier-value-strong {
        font-size: 1.15rem;
        font-weight: 700;
        color: #f8fafc;
        margin: 0;
    }

    .dossier-roles-panel {
        background: rgba(6, 10, 19, 0.85);
        border: 1px solid rgba(16, 185, 129, 0.24);
        border-left: 4px solid #10b981;
        border-radius: 12px;
        padding: 1.25rem 1.45rem;
        margin-bottom: 1.75rem;
    }

    .role-pill {
        display: inline-block;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        margin-right: 0.45rem;
        margin-top: 0.25rem;
        background: rgba(56, 189, 248, 0.14);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.32);
    }

    .dossier-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        align-items: center;
    }

    .dossier-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.25rem;
        border-radius: 9px;
        background: #1e293b;
        border: 1px solid #475569;
        color: #f8fafc;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

    .dossier-back-btn:hover {
        background: #334155;
        border-color: #94a3b8;
        transform: translateY(-1px);
    }

    .dossier-secondary-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.2rem;
        border-radius: 9px;
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: #7dd3fc;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .dossier-secondary-link:hover {
        background: rgba(56, 189, 248, 0.22);
        color: #e0f2fe;
    }
</style>
{% endblock %}

{% block body %}
    <div class="dossier-shell">
        <div class="dossier-header-row">
            <h1 class="dossier-page-title">Candidate Summary Details</h1>
            <a href="{{ path('app_candidate_index') }}" class="dossier-back-btn">&larr; Back to Candidates</a>
        </div>

        <div class="dossier-card">
            <div class="dossier-top-meta">
                <span class="dossier-id-chip">ID: {{ candidate.id }} &bull; TALENT-DOSSIER</span>
                <span class="dossier-status-chip">&#9679; Verified Profile</span>
            </div>

            <div class="dossier-profile-banner">
                <div class="dossier-avatar">{{ identifier|slice(0, 1)|upper }}</div>
                <div>
                    <span class="dossier-label" style="margin-bottom: 0.15rem;">Candidate Identity</span>
                    <h2 style="margin: 0; font-size: 1.45rem; color: #f8fafc;">{{ identifier }}</h2>
                </div>
            </div>

            <div class="dossier-field-grid">
                <div class="dossier-meta-box">
                    <span class="dossier-label">Candidate ID</span>
                    <p class="dossier-value-strong">#{{ candidate.id }}</p>
                </div>

                <div class="dossier-meta-box">
                    <span class="dossier-label">Primary Identifier</span>
                    <p class="dossier-value-strong">{{ identifier }}</p>
                </div>
            </div>

            <div class="dossier-roles-panel">
                <span class="dossier-label" style="color: #6ee7b7;">Assigned System Roles</span>
                {% if candidate.roles is defined and candidate.roles is not empty %}
                    {% for role in candidate.roles %}
                        <span class="role-pill">{{ role }}</span>
                    {% endfor %}
                {% else %}
                    <p style="margin: 0.25rem 0 0; color: #94a3b8;">No roles assigned.</p>
                {% endif %}
            </div>

            <div class="dossier-actions">
                <a href="{{ path('app_candidate_index') }}" class="dossier-back-btn">&larr; Back to Candidates</a>
                <a href="{{ path('app_job_index') }}" class="dossier-secondary-link">View Job Offers &rarr;</a>
                <a href="{{ path('app_numbers') }}" class="dossier-secondary-link">CS Market Stats &rarr;</a>
            </div>
        </div>
    </div>
{% endblock %}