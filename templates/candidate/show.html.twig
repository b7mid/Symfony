{% extends 'base.html.twig' %}

{% block title %}Candidate Profile #{{ candidate.id }} | TechPortal{% endblock %}

{% block body %}
    {% set identifier = candidate.email ?? candidate.userIdentifier ?? 'N/A' %}
    <div style="max-width: 650px; margin: 0 auto;">
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 2rem; border-radius: 12px;">
            <div style="display: flex; align-items: center; gap: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--accent-emerald); color: #064e3b; font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center;">
                    {{ identifier|slice(0, 1)|upper }}
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--accent-emerald); font-weight: 600; text-transform: uppercase;">Candidate ID #{{ candidate.id }}</span>
                    <h1 style="margin: 0.25rem 0 0; font-size: 1.5rem;">{{ identifier }}</h1>
                </div>
            </div>

            <div style="background: var(--bg-main); padding: 1.25rem; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 1.75rem;">
                <div style="margin-bottom: 1rem;">
                    <span style="color: var(--text-secondary); font-size: 0.85rem; display: block; margin-bottom: 0.35rem;">Assigned System Roles</span>
                    {% for role in candidate.roles %}
                        <span style="display: inline-block; font-size: 0.8rem; background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); padding: 0.25rem 0.65rem; border-radius: 4px; margin-right: 0.4rem; font-weight: 600;">
                            {{ role }}
                        </span>
                    {% endfor %}
                </div>
                <div>
                    <span style="color: var(--text-secondary); font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">Account Status</span>
                    <span style="color: var(--accent-emerald); font-weight: 600; font-size: 0.95rem;">● Verified Profile</span>
                </div>
            </div>

            <a href="{{ path('app_candidate_index') }}" class="btn btn-slate">&larr; Back to Candidates List</a>
        </div>
    </div>
{% endblock %}