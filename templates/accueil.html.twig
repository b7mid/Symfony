{% extends 'base.html.twig' %}

{% block title %}Astral Command | CS Career Hub{% endblock %}

{% block stylesheets %}
<style>
    .astro-hero-wrap {
        position: relative;
        max-width: 960px;
        margin: 0 auto 2.5rem;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: radial-gradient(circle at 20% 15%, rgba(56, 189, 248, 0.16), transparent 45%),
                    radial-gradient(circle at 85% 20%, rgba(251, 191, 36, 0.14), transparent 45%),
                    linear-gradient(180deg, #0b1120 0%, #060a13 100%);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(56, 189, 248, 0.08);
    }

    .astro-starfield {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(1.5px 1.5px at 12% 22%, rgba(255, 255, 255, 0.75) 50%, transparent 100%),
            radial-gradient(1px 1px at 28% 68%, rgba(125, 211, 252, 0.65) 50%, transparent 100%),
            radial-gradient(2px 2px at 47% 18%, rgba(253, 224, 71, 0.7) 50%, transparent 100%),
            radial-gradient(1px 1px at 66% 54%, rgba(255, 255, 255, 0.6) 50%, transparent 100%),
            radial-gradient(1.5px 1.5px at 81% 31%, rgba(167, 243, 208, 0.65) 50%, transparent 100%),
            radial-gradient(1px 1px at 91% 76%, rgba(255, 255, 255, 0.55) 50%, transparent 100%);
        pointer-events: none;
        z-index: 1;
    }

    .astro-banner-frame {
        position: relative;
        height: 290px;
        overflow: hidden;
        border-bottom: 1px solid rgba(148, 163, 184, 0.2);
    }

    .astro-banner-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.85) contrast(1.08) brightness(0.68);
        display: block;
    }

    .astro-banner-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(6, 10, 19, 0.25) 0%,
            rgba(6, 10, 19, 0.75) 65%,
            #080d18 100%
        );
    }

    .astro-hero-content {
        position: relative;
        z-index: 2;
        padding: 0 2rem 2.25rem;
        margin-top: -3.5rem;
    }

    .astro-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.88);
        border: 1px solid rgba(251, 191, 36, 0.35);
        color: #fcd34d;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 0.9rem;
    }

    .astro-title {
        margin: 0 0 0.65rem;
        font-size: clamp(1.85rem, 3.5vw, 2.65rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #f8fafc;
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.85);
    }

    .astro-title span {
        background: linear-gradient(90deg, #38bdf8, #a78bfa, #fbbf24);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .astro-subtitle {
        margin: 0 auto 1.75rem;
        max-width: 660px;
        color: #cbd5e1;
        font-size: 1rem;
        line-height: 1.6;
    }

    .astro-actions {
        display: flex;
        justify-content: center;
        gap: 0.9rem;
        flex-wrap: wrap;
        margin-bottom: 2.25rem;
    }

    .astro-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.45rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
        transition: transform 0.18s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

    .astro-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.08);
    }

    .astro-btn-numbers {
        background: linear-gradient(135deg, #2563eb, #0284c7);
        color: #ffffff;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
    }

    .astro-btn-jobs {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        color: #090d16;
        box-shadow: 0 8px 24px rgba(245, 158, 11, 0.3);
    }

    .astro-btn-candidates {
        background: linear-gradient(135deg, #059669, #10b981);
        color: #04130e;
        box-shadow: 0 8px 24px rgba(16, 185, 129, 0.3);
    }

    .astro-metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.15rem;
        text-align: left;
    }

    .astro-stat-card {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 12px;
        padding: 1.25rem;
        backdrop-filter: blur(10px);
    }

    .astro-stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
        font-weight: 700;
    }

    .astro-stat-value {
        font-size: 2rem;
        font-weight: 800;
        margin: 0.35rem 0 0.2rem;
        color: #f8fafc;
    }

    .astro-stat-hint {
        font-size: 0.82rem;
        color: #64748b;
        margin: 0;
    }
</style>
{% endblock %}

{% block body %}
    <div class="astro-hero-wrap">
        <div class="astro-starfield"></div>

        <div class="astro-banner-frame">
            <img src="{{ asset('images/images.jpg') }}" alt="CS Career Hub Banner">
            <div class="astro-banner-scrim"></div>
        </div>

        <div class="astro-hero-content" style="text-align: center;">
            <div class="astro-eyebrow">✦ Orbital Engineering & Talent Matrix</div>
            <h1 class="astro-title">Welcome to <span>CS Career Hub</span></h1>
            <p class="astro-subtitle">
                Navigate high-signal computer science job offers, inspect candidate dossiers, and analyze real-world engineering market statistics from a unified dark command deck.
            </p>

            <div class="astro-actions">
                <a href="{{ path('app_numbers') }}" class="astro-btn astro-btn-numbers">
                    <span>◈</span> View Numbers
                </a>
                <a href="{{ path('app_job_index') }}" class="astro-btn astro-btn-jobs">
                    <span>✦</span> View Job Offers
                </a>
                <a href="{{ path('app_candidate_index') }}" class="astro-btn astro-btn-candidates">
                    <span>❖</span> View Candidates
                </a>
            </div>

            <div class="astro-metrics-grid">
                <div class="astro-stat-card">
                    <div class="astro-stat-label" style="color: #fbbf24;">Active Positions</div>
                    <div class="astro-stat-value" style="color: #fde68a;">{{ jobCount is defined ? jobCount : '—' }}</div>
                    <p class="astro-stat-hint">Live roles indexed in database</p>
                </div>

                <div class="astro-stat-card">
                    <div class="astro-stat-label" style="color: #34d399;">Candidate Profiles</div>
                    <div class="astro-stat-value" style="color: #a7f3d0;">{{ candidateCount is defined ? candidateCount : '—' }}</div>
                    <p class="astro-stat-hint">Registered applicants & accounts</p>
                </div>

                <div class="astro-stat-card">
                    <div class="astro-stat-label" style="color: #38bdf8;">Market Telemetry</div>
                    <div class="astro-stat-value" style="color: #bae6fd;">6 Core</div>
                    <p class="astro-stat-hint">Salary, growth & stack indicators</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}