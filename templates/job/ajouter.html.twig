{% extends 'base.html.twig' %}

{% block title %}Gestion de Candidature{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <div class="card-body">
                    <h2 class="fw-bold text-dark mb-4 text-center">Formulaire de Candidature</h2>

                    {{ form_start(f, {'attr': {'enctype': 'multipart/form-data'}} ) }}
                        <div class="mb-3">
                            {{ form_row(f.candidat, {'attr': {'class': 'form-control rounded-pill px-3'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(f.contenu, {'attr': {'class': 'form-control rounded-4 px-3', 'rows': '4'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(f.cvFile, {'attr': {'class': 'form-control rounded-pill px-3'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(f.date, {'attr': {'class': 'form-control rounded-pill px-3'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(f.job, {'attr': {'class': 'form-select rounded-pill px-3'}}) }}
                        </div>

                        {{ form_widget(f.valider) }}
                    {{ form_end(f) }}

                    <div class="text-center mt-3">
                        <a href="{{ path('home') }}" class="text-decoration-none text-muted small">Retour à l'accueil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}