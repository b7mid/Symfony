{% extends 'base.html.twig' %}
{% block title %}Job Listings - db_jobs{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-dark mb-1"><i class="bi bi-search text-primary"></i> Available Job Openings</h1>
        <p class="text-muted mb-0">Discover your next career opportunity or publish a new listing.</p>
    </div>
    {% if app.user %}
        <a href="{{ path('app_job_new') }}" class="btn btn-primary shadow-sm px-4 rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Post a New Job
        </a>
    {% endif %}
</div>

<!-- Search Form Bar -->
<div class="card shadow-sm border-0 rounded-4 mb-4 p-3 bg-white">
    <form method="get" action="{{ path('app_job_index') }}" class="row g-3 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-light border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="q" value="{{ search }}" class="form-control bg-light border-0 py-2" placeholder="Search by job title, company, or location (e.g. Tunis, Remote)...">
            </div>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-dark py-2 rounded-pill fw-semibold">Filter</button>
        </div>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    {% for job in jobs %}
        <div class="col">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="card-title fw-bold text-dark mb-0">{{ job.title }}</h4>
                        <span class="badge bg-light text-primary border px-3 py-2 rounded-pill">{{ job.company ?? 'Company' }}</span>
                    </div>
                    <p class="card-text text-muted flex-grow-1 mt-2">
                        {{ job.description|length > 120 ? job.description|slice(0, 120) ~ '...' : job.description }}
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i> {{ job.location ?? 'Remote' }}</span>
                        <div class="d-flex align-items-center gap-1">
                            <a href="{{ path('app_job_show', {'id': job.id}) }}" class="btn btn-outline-primary btn-sm px-3 rounded-pill">View Details</a>
                            {% if app.user %}
                                <a href="{{ path('app_job_edit', {'id': job.id}) }}" class="btn btn-light btn-sm text-secondary rounded-circle p-2" title="Edit Job">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
                <i class="bi bi-search display-1 text-muted opacity-50"></i>
                <h3 class="text-muted mt-3">No matching job listings found</h3>
                <p class="text-muted mb-4">Try adjusting your search query or check back later!</p>
                <a href="{{ path('app_job_index') }}" class="btn btn-outline-primary px-4 rounded-pill">Reset Search</a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}