{% extends 'base.html.twig' %}

{% block title %}{{ job.title ?? 'Job Summary Details' }} | CS Career Hub{% endblock %}

{% block stylesheets %}
<style>
    .astro-job-dossier {
        max-width: 880px;
        margin: 0 auto;
    }

    .astro-job-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .astro-job-heading {
        margin: 0;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #f8fafc !important;
    }

    .astro-job-panel {
        position: relative;
        overflow: hidden;
        background-color: #0b1220 !important;
        background-image:
            radial-gradient(circle at 88% 12%, rgba(251, 191, 36, 0.16), transparent 42%),
            radial-gradient(circle at 12% 88%, rgba(56, 189, 248, 0.15), transparent 45%),
            linear-gradient(160deg, #0f172a 0%, #060b14 100%) !important;
        border: 1px solid rgba(148, 163, 184, 0.28) !important;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
        color: #f8fafc !important;
    }

    .astro-job-meta-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    }

    .astro-job-badge-id {
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fcd34d !important;
        background-color: rgba(245, 158, 11, 0.16) !important;
        border: 1px solid rgba(245, 158, 11, 0.4);
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
    }

    .astro-job-badge-live {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #34d399 !important;
        background-color: rgba(16, 185, 129, 0.16) !important;
        border: 1px solid rgba(16, 185, 129, 0.35);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
    }

    .astro-job-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .astro-job-card {
        background-color: rgba(15, 23, 42, 0.92) !important;
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
    }

    .astro-job-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: #94a3b8 !important;
        margin-bottom: 0.4rem;
    }

    .astro-job-value {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #f8fafc !important;
    }

    .astro-job-brief {
        background-color: rgba(6, 10, 19, 0.92) !important;
        border: 1px solid rgba(56, 189, 248, 0.25);
        border-left: 4px solid #38bdf8;
        border-radius: 12px;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.75rem;
    }

    .astro-job-desc {
        margin: 0;
        font-size: 1rem;
        line-height: 1.7;
        color: #e2e8f0 !important;
    }

    .astro-job-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        align-items: center;
    }

    .astro-job-btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.25rem;
        border-radius: 9px;
        background-color: #1e293b !important;
        border: 1px solid #475569;
        color: #f8fafc !important;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: background-color 0.2s ease, transform 0.15s ease;
    }

    .astro-job-btn-back:hover {
        background-color: #334155 !important;
        transform: translateY(-1px);
    }

    .astro-job-btn-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.2rem;
        border-radius: 9px;
        background-color: rgba(56, 189, 248, 0.14) !important;
        border: 1px solid rgba(56, 189, 248, 0.38);
        color: #7dd3fc !important;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .astro-job-btn-link:hover {
        background-color: rgba(56, 189, 248, 0.24) !important;
        color: #e0f2fe !important;
    }

    .astro-job-btn-apply {
        background-color: rgba(16, 185, 129, 0.2) !important;
        border: 1px solid rgba(16, 185, 129, 0.5) !important;
        color: #6ee7b7 !important;
    }

    .astro-job-btn-apply:hover {
        background-color: rgba(16, 185, 129, 0.32) !important;
        color: #a7f3d0 !important;
    }

    .astro-job-btn-guest {
        background-color: rgba(245, 158, 11, 0.16) !important;
        border: 1px solid rgba(245, 158, 11, 0.45) !important;
        color: #fcd34d !important;
    }

    .astro-flash {
        margin-bottom: 1.25rem;
        padding: 0.85rem 1.15rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.92rem;
        background: rgba(16, 185, 129, 0.16);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.35);
    }
</style>
{% endblock %}

{% block body %}
    {% set appliedJobs = app.session.get('applied_jobs', []) %}
    {% set isGuestLoggedIn = app.session.get('guest_authenticated', false) %}
    {% set alreadyApplied = job.id in appliedJobs %}

    <div class="astro-job-dossier">
        <div class="astro-job-topbar">
            <h1 class="astro-job-heading">Job Summary Details</h1>
            <a href="{{ path('app_job_index') }}" class="astro-job-btn-back">&larr; Back to Listings</a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="astro-flash">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="astro-job-panel">
            <div class="astro-job-meta-strip">
                <span class="astro-job-badge-id">ID: {{ job.id }} &bull; COSMIC-REQUISITION</span>
                <span class="astro-job-badge-live">&#9679; Active Position</span>
            </div>

            <div class="astro-job-grid">
                <div class="astro-job-card">
                    <span class="astro-job-label">Requisition ID</span>
                    <p class="astro-job-value">#{{ job.id }}</p>
                </div>

                <div class="astro-job-card">
                    <span class="astro-job-label">Role Title</span>
                    <p class="astro-job-value">{{ job.title ?? 'N/A' }}</p>
                </div>
            </div>

            <div class="astro-job-brief">
                <span class="astro-job-label" style="color: #7dd3fc !important;">Mission &amp; Technical Description</span>
                <p class="astro-job-desc">
                    {{ job.description ?? 'No description provided for this job.' }}
                </p>
            </div>

            <div class="astro-job-actions">
                {% if isGuestLoggedIn %}
                    <form action="{{ path('app_job_apply', {id: job.id}) }}" method="post" style="display:inline; margin:0;">
                        <button type="submit" class="astro-job-btn-link astro-job-btn-apply">
                            {{ alreadyApplied ? '✓ Applied for Job' : '✦ Apply for Job' }}
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('app_guest_portal') }}" class="astro-job-btn-link astro-job-btn-guest">
                        Guest Login to Apply &rarr;
                    </a>
                {% endif %}

                <a href="{{ path('app_job_index') }}" class="astro-job-btn-back">&larr; Back to Listings</a>
                <a href="{{ path('app_numbers') }}" class="astro-job-btn-link">View Numbers &rarr;</a>
            </div>
        </div>
    </div>
{% endblock %}