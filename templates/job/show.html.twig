{% extends 'base.html.twig' %}
{% block title %}Détails - {{ job.title }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a href="{{ path('app_job_index') }}" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Retour aux offres
                </a>
            </div>
            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-light text-primary border px-3 py-2 rounded-pill mb-2">{{ job.company ?? 'Entreprise' }}</span>
                            <h1 class="fw-bold text-dark mb-0">{{ job.title }}</h1>
                        </div>
                        <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i> {{ job.location ?? 'Remote' }}</span>
                    </div>
                    <hr class="my-4">
                    <p class="text-dark lh-base" style="white-space: pre-line;">{{ job.description }}</p>
                </div>
            </div>

            <!-- Section Liste des Candidatures -->
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold text-dark mb-0"><i class="bi bi-people text-primary me-2"></i> Candidatures Reçues</h3>
                    <a href="{{ path('add_candidat') }}" class="btn btn-sm btn-primary rounded-pill px-3">Ajouter un candidat</a>
                </div>
                <hr>
                {% for candidature in listCandidatures %}
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-dark mb-1">{{ candidature.candidat }}</h5>
                            <small class="text-muted">{{ candidature.date ? candidature.date|date('d-m-Y') : '' }}</small>
                        </div>
                        <p class="text-muted mb-2">{{ candidature.contenu }}</p>
                        
                        {% if candidature.cvFilename %}
                            <div class="mb-2">
                                <a href="{{ asset('uploads/cvs/' ~ candidature.cvFilename) }}" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> Télécharger le CV
                                </a>
                            </div>
                        {% endif %}

                        <div class="d-flex gap-2">
                            <a href="{{ path('edit_user', {'id': candidature.id}) }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Modifier</a>
                            <a href="{{ path('cand_delete', {'id': candidature.id}) }}" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce candidat ?');">Supprimer</a>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted text-center py-3">Aucune candidature enregistrée pour cette offre.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}