{% extends 'base.html.twig' %}

{% block title %}Liste des Candidats{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Liste des Candidats | <small><a href="{{ path('add_candidat') }}" class="btn btn-primary btn-sm rounded-pill px-3">Ajouter</a></small></h2>
        <a href="{{ path('app_job_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Voir les offres d'emploi</a>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nom & Prénom</th>
                    <th>Date</th>
                    <th>Contenu</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for candidat in lesCandidats %}
                <tr>
                    <td>{{ candidat.id }}</td>
                    <td class="fw-bold">{{ candidat.candidat | upper }}</td>
                    <td>{{ candidat.date ? candidat.date | date('d/m/Y') : '' }}</td>
                    <td>{{ candidat.contenu }}</td>
                    <td class="text-end">
                        <a class="btn btn-success btn-sm rounded-pill px-3" href="{{ path('edit_user', {'id': candidat.id}) }}">Modifier</a>
                        <a class="btn btn-danger btn-sm rounded-pill px-3" href="{{ path('cand_delete', {'id': candidat.id }) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer {{ candidat.candidat }} ?')">Supprimer</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Aucun candidat enregistré pour le moment.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}