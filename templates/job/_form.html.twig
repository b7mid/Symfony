{{ form_start(form) }}
    <div class="mb-3">{{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}</div>
    <div class="mb-3">{{ form_row(form.company, {'attr': {'class': 'form-control'}}) }}</div>
    <div class="mb-3">{{ form_row(form.location, {'attr': {'class': 'form-control'}}) }}</div>
    <div class="mb-3">{{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': '5'}}) }}</div>
    <button class="btn btn-primary w-100 py-2 mt-3 fw-semibold shadow-sm rounded-pill">
        <i class="bi bi-check-lg me-1"></i> {{ button_label|default('Save Job') }}
    </button>
{{ form_end(form) }}