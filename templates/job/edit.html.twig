{% extends 'base.html.twig' %}
{% block title %}Edit Job - {{ job.title }}{% endblock %}
{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="mb-3"><a href="{{ path('app_job_index') }}" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Job Listings</a></div>
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <div class="card-body">
                <h2 class="fw-bold text-dark mb-4"><i class="bi bi-pencil-square text-primary me-2"></i> Edit Job Posting</h2>
                {{ include('job/_form.html.twig', {'button_label': 'Update Job'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}