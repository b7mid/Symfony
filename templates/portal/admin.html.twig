{% extends 'base.html.twig' %}

{% block title %}Admin Portal | CS Career Hub{% endblock %}

{% block stylesheets %}
<style>
    .admin-shell {
        max-width: 1000px;
        margin: 0.5rem auto 2.5rem;
        position: relative;
    }

    .admin-panel {
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 88% 12%, rgba(251, 191, 36, 0.15), transparent 44%),
                    radial-gradient(circle at 12% 88%, rgba(56, 189, 248, 0.12), transparent 45%),
                    linear-gradient(160deg, #0f172a 0%, #060b14 100%);
        border: 1px solid rgba(251, 191, 36, 0.28);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    }

    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1.35rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    }

    .admin-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: #fcd34d;
        background: rgba(245, 158, 11, 0.14);
        border: 1px solid rgba(245, 158, 11, 0.35);
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 0.4rem;
    }

    .admin-title {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #f8fafc;
    }

    .admin-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .admin-table-wrap {
        overflow-x: auto;
        border-radius: 12px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: rgba(6, 10, 19, 0.85);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .admin-table thead {
        background: rgba(15, 23, 42, 0.95);
        border-bottom: 1px solid rgba(148, 163, 184, 0.22);
    }

    .admin-table th {
        padding: 0.9rem 1.1rem;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #94a3b8;
    }

    .admin-table tbody tr {
        border-bottom: 1px solid rgba(51, 65, 85, 0.55);
        transition: background-color 0.15s ease;
    }

    .admin-table tbody tr:last-child {
        border-bottom: none;
    }

    .admin-table tbody tr:hover {
        background: rgba(251, 191, 36, 0.06);
    }

    .admin-table td {
        padding: 0.9rem 1.1rem;
        color: #f1f5f9;
        font-size: 0.93rem;
        vertical-align: middle;
    }

    .admin-id-pill {
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.82rem;
        font-weight: 700;
        color: #fcd34d;
        background: rgba(245, 158, 11, 0.14);
        border: 1px solid rgba(245, 158, 11, 0.32);
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
    }

    .admin-role-tag {
        display: inline-block;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.76rem;
        font-weight: 700;
        color: #7dd3fc;
        background: rgba(56, 189, 248, 0.14);
        border: 1px solid rgba(56, 189, 248, 0.32);
        padding: 0.22rem 0.6rem;
        border-radius: 6px;
        margin-right: 0.35rem;
    }

    .admin-flash {
        margin-bottom: 1.15rem;
        padding: 0.85rem 1.1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.92rem;
        background: rgba(16, 185, 129, 0.16);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.35);
    }
</style>
{% endblock %}

{% block body %}
    <div class="admin-shell">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="admin-flash">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="admin-panel">
            <div class="admin-topbar">
                <div>
                    <div class="admin-eyebrow">⛨ Admin Command Console</div>
                    <h1 class="admin-title">Candidate Listing ({{ candidates|length }})</h1>
                </div>

                <div class="admin-actions">
                    <a href="{{ path('app_admin_candidates') }}" class="btn btn-blue">Open Full Candidate Table</a>
                    <a href="{{ path('app_portal_logout') }}" class="btn btn-slate">Sign Out</a>
                </div>
            </div>

            {% if candidates is empty %}
                <div style="padding: 2rem; text-align: center; border-radius: 12px; background: rgba(6, 10, 19, 0.75); border: 1px solid rgba(148, 163, 184, 0.16); color: #94a3b8;">
                    No candidates registered in the database yet.
                </div>
            {% else %}
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width: 110px;">ID</th>
                                <th>Candidate</th>
                                <th>Assigned Roles</th>
                                <th style="text-align: right;">Dossier</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for candidate in candidates %}
                                {% set identifier = candidate.email ?? candidate.userIdentifier ?? 'Unknown' %}
                                <tr>
                                    <td><span class="admin-id-pill">#{{ candidate.id }}</span></td>
                                    <td style="font-weight: 600; color: #f8fafc;">{{ identifier }}</td>
                                    <td>
                                        {% if candidate.roles is defined and candidate.roles is not empty %}
                                            {% for role in candidate.roles %}
                                                <span class="admin-role-tag">{{ role }}</span>
                                            {% endfor %}
                                        {% else %}
                                            <span style="color: #64748b;">ROLE_USER</span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: right;">
                                        <a href="{{ path('app_candidate_show', {id: candidate.id}) }}" class="btn btn-emerald" style="padding: 0.45rem 0.9rem; font-size: 0.84rem;">
                                            Inspect &rarr;
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}